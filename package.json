{
  "name": "modern-pdf-viewer",
  "private": true,
  "version": "1.0.0",
  "description": "Modern PDF Viewer - Desktop Application",
  "author": {
    "name": "Modern PDF Viewer",
    "email": "modernpdf@app.com"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "electron .",
    "app": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "npm run build && electron-builder --win --dir",
    "package": "npm run build && electron-builder --win nsis",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:linux": "npm run build && electron-builder --linux AppImage deb tar.gz",
    "package:linux:dir": "npm run build && electron-builder --linux --dir"
  },
  "build": {
    "appId": "com.modernpdf.app",
    "productName": "Modern PDF Viewer",
    "executableName": "modern-pdf-viewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "icon": "public/icon-512.png",
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "artifactName": "${name}-${version}.${ext}",
      "category": "Office",
      "maintainer": "Modern PDF Viewer <modernpdf@app.com>",
      "synopsis": "Modern, fast, offline PDF viewer and editor",
      "description": "Modern PDF Viewer - fast, offline, privacy-first PDF viewer and editor with annotations and document scan support.",
      "mimeTypes": [
        "application/pdf"
      ],
      "desktop": {
        "entry": {
          "Name": "Modern PDF Viewer",
          "Comment": "Fast offline PDF viewer and editor",
          "Keywords": "pdf;reader;viewer;editor;scan;annotate;"
        }
      }
    }
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "autoprefixer": "^10.6.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.68.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
